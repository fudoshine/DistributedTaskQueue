# -------------------------------------------------------
# Local development (running go binary directly)
# -------------------------------------------------------
# Copy this file to .env and adjust values as needed.
# When running via docker-compose, env vars are set in
# docker-compose.yml and this file is not used by the app.

# Redis
REDIS_ADDRESS=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# PostgreSQL
POSTGRES_CONN_STRING=postgres://postgres:password@localhost:5432/task_queue?sslmode=disable
MAX_RETRIES=3

# Metrics
METRICS_ADDR=:9090

# Queue
QUEUE_NAME=queue:video_processing
HOLD_TTL=20s
JANITOR_INTERVAL=5s
DELAYED_POLL_INTERVAL=2s
DEPTH_POLL_INTERVAL=5s
TASK_PRODUCER_INTERVAL=1s

# Worker
WORKER_COUNT=5
SHUTDOWN_TIMEOUT=30s
